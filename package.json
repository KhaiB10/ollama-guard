  "files": ["bin", "src", "README.md", "LICENSE"],
  "engines": { "node": ">=18.17" },
  "scripts": { "test": "node --test test/*.test.js" },
  "keywords": ["ollama", "llm", "tool-calling", "openai", "proxy", "context", "agents", "local-llm"],
  "repository": { "type": "git", "url": "git+https://github.com/KhaiB10/ollama-guard.git" },
  "author": "Khai Bustos",
  "license": "MIT"
}
